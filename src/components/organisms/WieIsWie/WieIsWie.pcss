.wie-is-wie {
  padding: var(--space-32) 0 var(--space-64);
}

/* ---------------------------- //
// Tak (group) sections          //
// ---------------------------- */

.wie-is-wie__tak {
  padding: var(--space-48) 0;
}

.wie-is-wie__tak-title {
  margin-bottom: var(--space-24);
}

/* ---------------------------- //
// Leaders grid                 //
// ---------------------------- */

.wie-is-wie__leaders {
  display: flex;
  flex-flow: row wrap;
  justify-content: center;
  gap: var(--space-16);

  @media (--mq-from-small) {
    justify-content: flex-start;
    gap: var(--space-24);
  }

  @media (--mq-from-medium) {
    gap: var(--space-32);
  }

  @media (--mq-from-large) {
    gap: var(--space-40);
  }
}

/* ---------------------------- //
// Leader card button            //
// ---------------------------- */

.wie-is-wie__leader-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-8);
  cursor: pointer;
  text-align: center;
  background: none;
  border: none;
  padding: 0;
  transition:
    transform var(--transition),
    box-shadow var(--transition);

  &:hover {
    transform: translateY(-4px);

    .leader__image {
      transform: scale(1.03);
      box-shadow: var(--drop-shadow-xl);
    }
  }

  &:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: var(--space-4);
  }
}

.wie-is-wie__leader-totem {
  color: var(--color-primary);
  font-size: 0.9rem;
  font-weight: var(--font-weight-normal);
}

/* ---------------------------- //
// Modal                         //
// ---------------------------- */

.wie-is-wie__modal-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-24);

  @media (--mq-from-small) {
    align-items: flex-start;
    gap: var(--space-32);
  }

  @media (--mq-from-medium) {
    flex-direction: row;
    gap: var(--space-48);
  }
}

.wie-is-wie__modal-image {
  position: relative;
  overflow: hidden;
  width: 8rem;
  height: 9.6rem;
  flex-shrink: 0;
  border-radius: var(--border-radius);
  filter: drop-shadow(var(--drop-shadow-lg));
  animation: modal-fade-in 288ms ease;

  @media (--mq-from-small) {
    width: 10rem;
    height: 12rem;
  }

  @media (--mq-from-medium) {
    width: 12rem;
    height: 14.4rem;
  }
}

.wie-is-wie__modal-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.wie-is-wie__modal-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
  width: 100%;
  animation: modal-fade-in 288ms ease;
  text-align: center;

  @media (--mq-from-small) {
    text-align: left;
  }
}

.wie-is-wie__modal-name {
  margin: 0;
}

.wie-is-wie__modal-totem {
  margin: 0;
  color: var(--color-primary);
  font-size: 1.5rem;
  font-weight: var(--font-weight-semibold);
}

.wie-is-wie__modal-details {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-16);
  margin-top: var(--space-16);
  width: 100%;

  @media (--mq-from-small) {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-16) var(--space-32);
  }

  @media (--mq-from-medium) {
    grid-template-columns: repeat(2, max-content);
    gap: var(--space-16) var(--space-64);
  }

  @media (--mq-from-large) {
    gap: var(--space-16) var(--space-96);
  }
}

.wie-is-wie__modal-detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.wie-is-wie__modal-detail--span-2 {
  @media (--mq-from-small) {
    grid-column: span 2;
  }
}

.wie-is-wie__modal-detail-label {
  color: var(--color-primary-600);
  font-size: 0.75rem;
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.wie-is-wie__modal-detail-value {
  margin: 0;
  color: var(--color-neutral-900);
  font-size: 1rem;
  line-height: 1.5;
  word-break: break-word;
}

.wie-is-wie__modal-bio {
  margin-top: var(--space-16);
  padding-top: var(--space-16);
  border-top: 1px solid var(--color-neutral-200);
}

/* ---------------------------- //
// Animation                     //
// ---------------------------- */

@keyframes modal-fade-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
