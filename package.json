{
  "name": "scoutinglommel.be",
  "private": true,
  "scripts": {
    "build:css": "pnpm run \"/^build:css:[^:]+$/\"",
    "build:css:components": "postcss src/components/**/*.pcss --base src/components --dir src/components --ext css --env production",
    "build:css:global": "postcss src/assets/styles/global.pcss --output src/app/global.css --env production",
    "build:next": "next build",
    "build": "pnpm run \"/^build:[^:]+$/\"",
    "chromatic": "npx chromatic --project-token=chpt_8d08d2bcd7ac9cd",
    "fetch-schema": "npx tsx fetch-schema.ts",
    "codegen": "pnpm fetch-schema && graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm fetch-schema && graphql-codegen --config codegen.ts --watch",
    "dev:css": "pnpm run \"/^dev:css:[^:]+$/\"",
    "dev:css:components": "postcss src/components/**/*.pcss --base src/components --dir src/components --ext css -w",
    "dev:css:global": "postcss src/assets/styles/global.pcss --output src/app/global.css -w",
    "dev:next": "next dev",
    "dev": "run-p \"dev:css\" \"dev:next\"",
    "emails": "email dev --dir src/emails/templates --port 3001",
    "export": "next export",
    "lint:eslint": "eslint . --fix",
    "lint:ls-lint": "npx ls-lint",
    "lint:stylelint": "npx stylelint \"**/*.pcss\" --fix",
    "lint:typescript": "tsc",
    "lint": "pnpm run \"/^lint:[^:]+$/\"",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm codegen",
    "start": "next start",
    "storybook:build": "storybook build",
    "storybook:start": "storybook dev -p 6006",
    "storybook": "pnpm run \"/^dev:css:[^:]+$/\" && pnpm run storybook:start",
    "build-storybook": "pnpm run \"/^build:css:[^:]+$/\" && pnpm run storybook:build"
  },
